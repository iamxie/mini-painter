{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release (x64, static CRT, vcpkg manifest)",
      "description": "The one build configuration. Needs VCPKG_ROOT; MP_7Z_DLL (path to the official 7z.dll) is optional but the archive tests fail without it.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "MP_BUILD_APP": "ON",
        "MP_7Z_DLL": { "type": "FILEPATH", "value": "$env{MP_7Z_DLL}" }
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "verbosity": "verbose" },
      "execution": { "timeout": 900 }
    }
  ]
}
